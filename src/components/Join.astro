---
import HubCard from "./HubCard.astro";
import QueueStatusCard from "./QueueStatusCard.astro";
import { getQueue } from "../utils/requests";

const stats = [
  { icon: "mdi:map-marker-outline", value: "5", label: "Active Hubs" },
  { icon: "mdi:clock-outline", value: "6m", label: "Avg Flow" },
  { icon: "mdi:account-group", value: "43", label: "Queuers" },
];

const { adminId, queueId } = Astro.props;
const res = await getQueue(adminId, queueId);
const {
  active,
  address,
  admin_name,
  average_service_time,
  current_capacity,
  queue_capacity,
  queue_name,
  total_served,
} = res[0];
/*
    _id: '67c31d3485f5ce8ae3d65c52',
    active: false,
    address: null,
    admin_id: '67a6361bcb1c476befe27dfe',
    admin_name: null,
    average_service_time: null,
    created_at: '2025-03-01T14:44:04.806Z',
    current_capacity: 23,
    queue_capacity: 100,
    queue_name: 'account creation',
    service_start_time: '2026-01-30T17:27:58.807Z',
    sub_admin_id: null,
    total_served: 0,
    total_service_time: null,
    updated_at: '2026-04-04T20:20:13.844Z'

*/
---

<main>
  <HubCard name={queue_name} address={address ?? "n/a"} />
  <QueueStatusCard
    inLine={current_capacity}
    averageServiceTime={average_service_time}
    flowRate="Fast Pace"
    adminId={adminId}
    queueId={queueId}
  />
</main>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>
